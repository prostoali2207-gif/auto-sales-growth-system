{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-spec.schema.json",
  "title": "Auto Sales Growth Content Architecture Specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_spec_id",
    "experiment_id",
    "status",
    "source_strategy_reference",
    "constraint_model",
    "content_objective",
    "attention_contract",
    "structural_timeline",
    "pacing",
    "proof_architecture",
    "offer_and_cta",
    "visual_communication_requirements",
    "creator_handoff",
    "structural_observability"
  ],
  "properties": {
    "content_spec_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["READY_FOR_CREATOR", "BLOCKED_MISSING_INPUT", "NEEDS_STRATEGIST_REVISION"]},
    "source_strategy_reference": {"type": "string", "minLength": 1},
    "constraint_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested_variable", "locked_variables", "bounded_variables", "free_variables", "forbidden_deviations"],
      "properties": {
        "tested_variable": {"type": ["string", "null"]},
        "locked_variables": {"type": "array", "items": {"type": "string"}},
        "bounded_variables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable", "allowed_range"],
            "properties": {
              "variable": {"type": "string", "minLength": 1},
              "allowed_range": {"type": "string", "minLength": 1}
            }
          }
        },
        "free_variables": {"type": "array", "items": {"type": "string"}},
        "forbidden_deviations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "content_objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "primary_funnel_role", "audience_signal", "approved_mechanism", "desired_viewer_action"],
      "properties": {
        "platform": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["INSTAGRAM", "YOUTUBE_SHORTS", "YOUTUBE_LONG", "TELEGRAM"]}},
        "primary_funnel_role": {"type": "string", "enum": ["REACH", "TRUST", "LEAD", "DIRECT_SALE"]},
        "audience_signal": {"type": "string", "minLength": 1},
        "approved_mechanism": {"type": "string", "minLength": 1},
        "desired_viewer_action": {"type": "string", "minLength": 1}
      }
    },
    "attention_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_family", "opening_job", "immediate_relevance", "viewer_question_or_tension", "payoff_obligation", "required_evidence_or_asset"],
      "properties": {
        "hook_family": {"type": "string", "minLength": 1},
        "opening_job": {"type": "string", "minLength": 1},
        "immediate_relevance": {"type": "string", "minLength": 1},
        "viewer_question_or_tension": {"type": "string", "minLength": 1},
        "payoff_obligation": {"type": "string", "minLength": 1},
        "required_evidence_or_asset": {"type": "array", "items": {"type": "string"}}
      }
    },
    "structural_timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "job", "information_required", "dependency", "visual_communication_requirement", "target_time_range", "transition_job", "lock_status"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "job": {"type": "string", "minLength": 1},
          "information_required": {"type": "array", "items": {"type": "string"}},
          "dependency": {"type": "array", "items": {"type": "string"}},
          "proof_requirement": {"type": "array", "items": {"type": "string"}},
          "visual_communication_requirement": {"type": "array", "items": {"type": "string"}},
          "target_time_range": {"type": "string", "minLength": 1},
          "transition_job": {"type": "string", "minLength": 1},
          "lock_status": {"type": "string", "enum": ["LOCKED", "BOUNDED", "FREE"]}
        }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_duration_range", "rationale", "fast_zones", "slow_zones", "removable_material_rules"],
      "properties": {
        "target_duration_range": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "fast_zones": {"type": "array", "items": {"type": "string"}},
        "slow_zones": {"type": "array", "items": {"type": "string"}},
        "removable_material_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "proof_architecture": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_or_implication", "evidence_reference", "evidence_scope", "evidence_strength", "placement", "remaining_uncertainty", "failure_condition"],
        "properties": {
          "claim_or_implication": {"type": "string", "minLength": 1},
          "evidence_reference": {"type": "string", "minLength": 1},
          "evidence_scope": {"type": "string", "minLength": 1},
          "evidence_strength": {"type": "string", "minLength": 1},
          "placement": {"type": "string", "minLength": 1},
          "remaining_uncertainty": {"type": ["string", "null"]},
          "failure_condition": {"type": "string", "minLength": 1}
        }
      }
    },
    "offer_and_cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_offer_constraints", "offer_placement", "cta_objective", "cta_destination", "cta_placement", "transition_job", "competing_actions_forbidden"],
      "properties": {
        "approved_offer_constraints": {"type": "array", "items": {"type": "string"}},
        "offer_placement": {"type": "string", "minLength": 1},
        "cta_objective": {"type": "string", "minLength": 1},
        "cta_destination": {"type": "string", "minLength": 1},
        "cta_placement": {"type": "string", "minLength": 1},
        "transition_job": {"type": "string", "minLength": 1},
        "competing_actions_forbidden": {"type": "boolean"}
      }
    },
    "visual_communication_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_show", "must_remain_readable_or_visible", "must_not_imply", "asset_gaps"],
      "properties": {
        "must_show": {"type": "array", "items": {"type": "string"}},
        "must_remain_readable_or_visible": {"type": "array", "items": {"type": "string"}},
        "must_not_imply": {"type": "array", "items": {"type": "string"}},
        "asset_gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "creator_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_preserve", "bounded", "may_choose", "must_escalate"],
      "properties": {
        "must_preserve": {"type": "array", "items": {"type": "string"}},
        "bounded": {"type": "array", "items": {"type": "string"}},
        "may_choose": {"type": "array", "items": {"type": "string"}},
        "must_escalate": {"type": "array", "items": {"type": "string"}}
      }
    },
    "structural_observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_family", "block_order", "planned_duration_range", "proof_positions", "offer_position", "cta_position", "tested_variable", "locked_variables"],
      "properties": {
        "hook_family": {"type": "string", "minLength": 1},
        "block_order": {"type": "array", "items": {"type": "string"}},
        "planned_duration_range": {"type": "string", "minLength": 1},
        "proof_positions": {"type": "array", "items": {"type": "string"}},
        "offer_position": {"type": "string", "minLength": 1},
        "cta_position": {"type": "string", "minLength": 1},
        "tested_variable": {"type": ["string", "null"]},
        "locked_variables": {"type": "array", "items": {"type": "string"}},
        "declared_deviations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "blocker_reason": {"type": ["string", "null"]},
    "strategist_revision_request": {"type": ["string", "null"]}
  }
}

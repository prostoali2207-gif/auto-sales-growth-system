{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth-knowledge-entry.schema.json",
  "title": "Shared Growth Knowledge Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "created_at",
    "source_experiment_ids",
    "scope",
    "learning",
    "evidence_grade",
    "decision",
    "reusable_conditions",
    "invalid_conditions",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "knowledge_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_experiment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "funnel_roles",
        "audience",
        "vehicle_context"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "funnel_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "REACH",
              "TRUST",
              "LEAD",
              "DIRECT_SALE"
            ]
          }
        },
        "audience": {
          "type": "string"
        },
        "vehicle_context": {
          "type": "string"
        }
      }
    },
    "learning": {
      "type": "string"
    },
    "evidence_grade": {
      "type": "string",
      "enum": [
        "STRONG",
        "MODERATE",
        "WEAK"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "SCALE",
        "ITERATE",
        "KILL",
        "PARK",
        "BASELINE_ONLY"
      ]
    },
    "reusable_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalid_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PROVISIONAL",
        "CONFIRMED",
        "RETIRED"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
